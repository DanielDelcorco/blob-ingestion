# Copy this file to `local.settings.env` and fill the values before running locally.
# Do NOT commit secrets — this file is for local development convenience only.

# Azure Blob storage credentials
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_SAS_TOKEN=

# Containers / paths (defaults are provided in code if omitted)
DEFAULT_GROUP_BLOB_CONTAINER=blob-container
CUSTOMER_BLOB_CONTAINER=customer-container

# MongoDB connection (use a local or cloud URI)
MONGO_URI=mongodb://username:password@localhost:27017
MONGO_DB_NAME=your_db_name
DEFAULT_GROUP_MONGO_COLLECTION=default_group_collection
CUSTOMER_MONGO_COLLECTION=customer_collection

# OpenTelemetry (optional) - set to collector endpoint or leave empty to disable
OTEL_EXPORTER_OTLP_ENDPOINT=

# Azure Functions runtime settings
FUNCTIONS_WORKER_RUNTIME=python
# Storage account connection string (required by Functions host). For local testing with Azurite:
# AzureWebJobsStorage=UseDevelopmentStorage=true
AzureWebJobsStorage=

# Logging
LOG_LEVEL=INFO

# Usage:
# 1) Copy the file and fill secrets:
#    cp local.settings.env.example local.settings.env
#    # edit local.settings.env and set required vars
# 2) Run the container and pass the env file:
#    docker run --env-file local.settings.env -p 8080:80 myfuncapp:latest
